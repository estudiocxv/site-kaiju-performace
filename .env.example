# Copie para .env (no computador) ou cadastre na Vercel
# (Settings → Environment Variables). Nunca suba o .env para o GitHub.

# Chave que protege o login do painel. Gere uma nova para cada servidor:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Primeiro acesso ao painel. Só é usado quando ainda não existe nenhum usuário.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Banco: vazio = arquivo data/kaiju.db. Na Vercel, o Turso preenche estas duas:
# TURSO_DATABASE_URL=libsql://...
# TURSO_AUTH_TOKEN=

# Fotos do painel: vazio = pasta data/media. Na Vercel, o Blob preenche esta:
# BLOB_READ_WRITE_TOKEN=

# Endereço do site, usado só na primeira carga dos dados da empresa
# (depois disso, muda em Dados da empresa no painel).
# SITE_URL=https://www.kaijuperformance.pro

# Só no computador: entra no painel sem senha com `npm run dev`. NUNCA no servidor.
# ADMIN_AUTOLOGIN=true
