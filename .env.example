# Copie para .env (no computador) ou cadastre no hPanel da Hostinger
# (Sites → Node.js → Variáveis de ambiente). Nunca suba o .env para o GitHub.

# Chave que protege o login do painel. Gere uma nova para cada servidor:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Primeiro acesso ao painel. Só é usado quando ainda não existe nenhum usuário.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Banco e fotos enviadas. Na Hostinger, FORA da pasta do site (que é apagada
# a cada deploy). Troque u123456789 pelo seu usuário do hPanel.
# DATABASE_URI=file:/home/u123456789/kaiju-data/kaiju.db
# MEDIA_DIR=/home/u123456789/kaiju-data/media

# Endereço do site, usado só na primeira carga dos dados da empresa
# (depois disso, muda em Dados da empresa no painel).
# SITE_URL=https://www.kaijuperformance.pro

# Só no computador: entra no painel sem senha com `npm run dev`. NUNCA no servidor.
# ADMIN_AUTOLOGIN=true
